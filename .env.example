# Copy this file to .env and fill in your own values. Never commit .env.
# Leave both LLM keys empty to run in rule-based mode (no AI, still works).

# --- Primary LLM: Groq (free tier, no credit card) -> https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Only for reasoning models such as gpt-oss ("low" = faster). Leave empty for other models.
LLM_REASONING_EFFORT=low

# --- Fallback LLM (optional): Google AI Studio / Gemini (free tier) -> https://aistudio.google.com/apikey
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_LLM_MODEL=gemini-flash-lite-latest

# --- Maps: OpenStreetMap services (free, no key). Please respect their usage policies.
GEO_USER_AGENT=JeenyChatbot/1.0 (+https://github.com/anaskasasbeh/JeenyChatbot)
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
# Routing servers (OSRM API), tried in order
OSRM_URL=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car
# Map tiles shown in the browser (OSM standard tiles: free, no key, attribution required)
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- App
RATE_LIMIT_PER_MINUTE=15
LOG_LEVEL=INFO
